# Database — Supabase (Project → Connect → ORMs → Prisma)
# Pooled connection, used by the app:
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&schema=pitchup"
# Direct connection, used by prisma migrate:
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=pitchup"
# Offline alternative: `npm run db:dev` and use its postgres:// URL (add &connection_limit=1&pgbouncer=true) for both.
APP_URL="http://localhost:3000"

# Comma-separated emails that become admins on login
ADMIN_EMAILS=""

# Supabase Auth (Project Settings -> API). Leave SUPABASE_URL empty locally to use the demo dev login.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Optional, secret: lets "delete account" also remove the Supabase login.
SUPABASE_SERVICE_ROLE_KEY=""
# Random string that signs the session cookie: openssl rand -base64 32
SESSION_SECRET=""

# Gemini (https://aistudio.google.com/apikey). Empty = canned AI replies + heuristic scoring.
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-3.5-flash"
GEMINI_LIVE_MODEL="gemini-3.8-live"

# Dodo Payments (https://app.dodopayments.com). dodo_test_... key = test mode, dodo_live_... = live.
DODO_PAYMENTS_API_KEY=""
# One "Pay what you want" product in USD (min $1); the app sets the exact price per checkout.
DODO_PRODUCT_ID=""
# Developer -> Webhooks signing secret (whsec_...) for https://YOUR_DOMAIN/api/dodo/webhook
DODO_WEBHOOK_KEY=""
