{
  "name": "pitchup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:seed": "tsx prisma/seed.ts",
    "eval:customer": "tsx --env-file=.env scripts/eval-customer.ts",
    "db:dev": "prisma dev --name pitchup --detach",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.118.0",
    "next": "15.5.28",
    "next-intl": "^4.14.9",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "jose": "^5.10.0"
  }
}
